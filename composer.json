{
    "require": {
        "robmorgan/phinx": "^0.16.1",
        "vlucas/phpdotenv": "^5.7",
        "pocketarc/codeigniter": "^3.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.59",
        "haemanthus/codeigniter3-ide-helper": "^1.0",
        "kint-php/kint": "^5.1"
    },
    "scripts": {
        "post-install-cmd": [
            "@generate-ide-helper"
        ],
        "generate-ide-helper": [
            "@php -r \"if (file_exists('vendor/bin/ide-helper')) { passthru('vendor/bin/ide-helper generate'); }\""
        ]
    },
    "config": {
        "sort-packages": true
    }
}
